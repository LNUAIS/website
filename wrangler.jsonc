{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lnuai-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Needed so a revalidation can call back into the worker.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lnuai-website"
    }
  ],
  // Holds pages regenerated by `revalidate`. Create it once with:
  //   npx wrangler r2 bucket create lnuai-website-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "lnuai-website-cache"
    }
  ]
}
